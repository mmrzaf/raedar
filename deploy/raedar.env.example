# Application settings, passed into the raedar container. Optional: copy to
# raedar.env (chmod 600) only for what you want to change. Never commit it.
# Every RAEDAR_* variable is documented in docs/configuration.md.

RAEDAR_TZ=UTC
RAEDAR_PUBLIC_URL=https://raedar.example.com
RAEDAR_LOG_LEVEL=info

# Traefik access log: read from the Traefik container's output by default
# (accessLog.format=json, no filePath). To read a mounted file instead:
# RAEDAR_ACCESSLOG_PATH=/logs/access.log
# RAEDAR_TLS_CHECK_ADDR=traefik:443

# Optional active availability checks (off by default).
# RAEDAR_PROBES=on
# Also have Traefik keep the User-Agent in its access log
# (accessLog.fields.headers.names.User-Agent=keep) so checks are not counted as traffic.

# Notifications: leave a channel's variables unset to disable it.
# RAEDAR_TELEGRAM_TOKEN=
# RAEDAR_TELEGRAM_CHAT_IDS=
# RAEDAR_WEBHOOK_URL=
# RAEDAR_WEBHOOK_SECRET=
# RAEDAR_NOTIFY_WARNING=none
# RAEDAR_NOTIFY_CRITICAL=telegram
# RAEDAR_DIGEST_AT=09:00

# Outbound proxy, only if the host cannot reach notification services directly.
# RAEDAR_OUTBOUND_PROXY=http://proxy:3128
# RAEDAR_OUTBOUND_PROXY_FOR=telegram,webhook,heartbeat
