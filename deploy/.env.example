# Compose-level settings. Copy to .env, chmod 600, and fill in. Never commit .env.
# Generate secrets with: openssl rand -hex 32

RAEDAR_DOMAIN=raedar.example.com
RAEDAR_DB_PASSWORD=__GENERATE_HEX_32__
# htpasswd line; every $ must be written as $$ here.
# Create: echo $(htpasswd -nB admin) | sed -e 's/\$/\$\$/g'
RAEDAR_BASIC_AUTH=__SET__

# Optional
# RAEDAR_IMAGE=ghcr.io/mmrzaf/raedar:1.0.0
# TRAEFIK_NETWORK=traefik
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERT_RESOLVER=letsencrypt
# RAEDAR_EXTRA_MIDDLEWARES=
# Set to 0 to withhold /system/df (Docker disk usage) from Raedar.
# SOCKET_PROXY_SYSTEM=1
