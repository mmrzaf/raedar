# Raedar on the Waiotech host. Copy to .env (chmod 600) and fill in.
# Secrets are never committed: generate them with `openssl rand -hex 32`.

APP_NAME=raedar
APP_DOMAIN=raedar.waiotech.com
APP_IMAGE=raedar:0.1.0

# Shared PostgreSQL (see db/init.sql).
APP_DB_NAME=raedar
APP_DB_USER=raedar
APP_DB_PASSWORD=__GENERATE_HEX_32__

RAEDAR_TZ=Asia/Tehran
RAEDAR_PUBLIC_URL=https://raedar.waiotech.com
RAEDAR_LOG_LEVEL=info

# Traefik writes JSON access logs to /srv/logs/traefik/access.log.
RAEDAR_ACCESSLOG_PATH=/logs/access.log
RAEDAR_TLS_CHECK_ADDR=traefik:443
# auto: monitor systemd units when the bus answers, and carry on without it.
RAEDAR_SYSTEMD=auto

# The host reaches Telegram only through the Xray proxy; the SMS provider is
# reached directly.
RAEDAR_OUTBOUND_PROXY=http://172.27.0.1:1080
RAEDAR_OUTBOUND_PROXY_FOR=telegram,webhook,heartbeat

# Channels. Leave a channel's variables empty to disable it. Warnings go to
# Telegram; SMS is for critical incidents only.
RAEDAR_TELEGRAM_TOKEN=__SET__
RAEDAR_TELEGRAM_CHAT_IDS=__SET__
# SMS is a single generic HTTP shape. URL and body templates support
# {{to}}, {{message}}, {{from}} and {{api_key}} placeholders. Most providers
# accept the key via an Authorization header — keep it in a secret file.
RAEDAR_SMS_TO=__SET__
RAEDAR_SMS_FROM=__SET__
RAEDAR_SMS_HTTP_URL=https://sms.example.com/v1/send
# RAEDAR_SMS_HTTP_HEADER_FILE=/run/secrets/sms_auth
# RAEDAR_SMS_HTTP_API_KEY_FILE=/run/secrets/sms_api_key
RAEDAR_SMS_HTTP_BODY={"to":"{{to}}","from":"{{from}}","text":"{{message}}"}
RAEDAR_SMS_HTTP_ENCODING=json
RAEDAR_NOTIFY_WARNING=telegram
RAEDAR_NOTIFY_CRITICAL=telegram,sms
RAEDAR_DIGEST_CHANNELS=telegram
RAEDAR_DIGEST_AT=09:00

# Silencing. Quiet hours hold warnings (critical pages through by default).
# RAEDAR_QUIET_FROM=22:00
# RAEDAR_QUIET_TO=07:00
# RAEDAR_QUIET_TZ=Asia/Tehran
RAEDAR_QUIET_PAGE_CRITICAL=true
# Minimum time between two pages for the same (rule, subject), and overrides.
RAEDAR_PAGER_COOLDOWN=30m
# RAEDAR_PAGER_COOLDOWN_BY_RULE=route.down=15m,host.disk=1h
# One "all quiet" message after this long with no page.
# RAEDAR_STAND_DOWN_AFTER=24h
# Silence an app for this long after each deploy.
# RAEDAR_DEPLOY_SILENCE=5m

# Presentation: rename subjects in messages and the UI.
# RAEDAR_SUBJECT_NAMES=fallback@file=Unrouted traffic

# Optional webhook:
# RAEDAR_WEBHOOK_URL=
# RAEDAR_WEBHOOK_SECRET=
#
# Optional heartbeat to another host:
# RAEDAR_HEARTBEAT_URL=
# RAEDAR_HEARTBEAT_HEADER=
